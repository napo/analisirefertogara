{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "onedrive",
  "description": "Synchronisation with the user's OneDrive, only after the user connects it: Microsoft sign-in, Graph and the short-lived download addresses of OneDrive",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://login.microsoftonline.com/*" },
        { "url": "https://graph.microsoft.com/*" },
        { "url": "https://*.1drv.com/*" },
        { "url": "https://*.microsoftpersonalcontent.com/*" },
        { "url": "https://*.sharepoint.com/*" }
      ]
    }
  ]
}
