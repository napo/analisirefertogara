{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Referto Volley",
  "version": "0.1.0",
  "identifier": "it.napolitano.refertovolley",
  "build": {
    "frontendDist": "../webapp/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Referto Volley",
        "width": 1280,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Sports",
    "shortDescription": "Analisi dei referti di pallavolo",
    "license": "WTFPL",
    "licenseFile": "../LICENSE"
  }
}
